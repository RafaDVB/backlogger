{
  "name": "backlogger",
  "private": true,
  "version": "1.0.0",
  "description": "A local-first video game backlog and shelf tracker",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && vitest run",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.8.2",
    "@tauri-apps/plugin-opener": "^2",
    "pinia": "^4.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.5"
  }
}